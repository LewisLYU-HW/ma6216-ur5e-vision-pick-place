* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.png binary
*.mp4 binary
# Preserve exported CAD bytes for manifest checksums; trimesh ends OBJ with a blank line.
/assets/printable/*.obj -text whitespace=-blank-at-eof
/assets/printable/*.stl binary
/assets/printable_library/*.obj -text whitespace=-blank-at-eof
/assets/printable_library/*.stl binary
/assets/palletizing/*.obj -text whitespace=-blank-at-eof
/assets/palletizing/*.stl binary
# Keep third-party mesh/XML/texture source hashes stable across operating systems.
/assets/library/gso/** -text whitespace=-blank-at-eof,-blank-at-eol
# Preserve image-reconstruction provenance hashes, including exported OBJ EOFs.
/assets/reconstructed/** -text whitespace=-blank-at-eof
/assets/reconstructed/*/model.obj linguist-generated=true
/assets/reconstructed/workshop/*/model.obj linguist-generated=true
